<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html must always be revalidated -- it's the only file whose name
# never changes between deploys, so if a browser caches it, it can keep
# pointing at old (deleted) hashed JS/CSS filenames forever and never
# notice a new version was deployed.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Hashed build output (main-XXXX.js, styles-XXXX.css, ...) is safe to
  # cache aggressively -- the filename itself changes whenever the
  # content does, so a stale cache just means an unused old file.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
